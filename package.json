{
  "name": "dynamic-voice-channels",
  "version": "1.0.0-alpha.1",
  "description": "Discord bot for on-demand voice channel creation, built with Rhidium",
  "license": "ISC",
  "author": {
    "name": "Richard Hillebrand (Mirasaki)",
    "email": "me@mirasaki.dev",
    "url": "https://mirasaki.dev/"
  },
  "main": "dist/index.js",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "prebuild": "pnpm run db:generate && pnpm --filter rhidium run build && pnpm --filter rhidium run db:generate",
    "build": "tsdown",
    "clean": "git clean -xdf dist generated; rimraf rhidium/dist",
    "clean:full": "pnpm run clean && rimraf rhidium/node_modules && git clean -xdf logs node_modules",
    "cp:locales": "cd rhidium && pnpm run cp:locales ../locales",
    "cp:prisma": "cp rhidium/prisma/schema.prisma prisma/schemas/rhidium.prisma",
    "db:generate": "prisma generate",
    "db:init": "mkdir -p prisma/migrations/0_init && prisma migrate diff --from-empty --to-schema prisma/schemas --script > prisma/migrations/0_init/migration.sql",
    "postdb:init": "prisma migrate resolve --applied 0_init",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:status": "prisma migrate status",
    "predev": "cd rhidium && pnpm run db:generate",
    "dev": "concurrently -n \"rhidium,app\" -c \"cyan,green\" \"cd rhidium && pnpm run build:watch\" \"wait-on rhidium/dist/index.cjs && tsx watch --clear-screen=false src/index.ts\"",
    "pregen:schema": "pnpm --filter rhidium run build",
    "gen:schema": "tsx scripts/generate-schema.ts",
    "start": "node ./dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "up:bump": "pnpm run up:bump:minor",
    "up:bump:minor": "pnpm run up:submodules && pnpm -r up",
    "up:bump:major": "pnpm run up:submodules && pnpm -r up --latest",
    "up:submodules": "git submodule update --remote --merge"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "7.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "rhidium": "workspace:^",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.2",
    "tsdown": "0.19.0-beta.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
